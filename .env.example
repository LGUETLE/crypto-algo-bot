# Copy this file to .env and fill in your keys.
# .env must NEVER be committed to git!
#
# Variable names follow the ccxt exchange id from config/settings.yaml:
#   <EXCHANGE_ID_UPPERCASE>_API_KEY / _SECRET / _PASSPHRASE
# API keys: trading permission only, NO withdrawal permission, IP whitelist if the venue supports it.

# OKX Europe (EEA) - ccxt id "myokx" (keys must be created on the EEA site, they do not work on global OKX)
MYOKX_API_KEY=your_api_key_here
MYOKX_SECRET=your_secret_here
MYOKX_PASSPHRASE=your_passphrase_here

# OKX global (ccxt id "okx") - not available to EEA residents
# OKX_API_KEY=
# OKX_SECRET=
# OKX_PASSPHRASE=

# Hyperliquid (later) - use an API/agent wallet, never your main wallet key
# HYPERLIQUID_WALLET_ADDRESS=
# HYPERLIQUID_PRIVATE_KEY=

# paper | demo | live   (the --mode flag of main.py overrides this)
TRADING_MODE=paper

# Telegram (optional but recommended)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
